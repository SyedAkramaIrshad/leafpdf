{
  "name": "leafpdf",
  "private": true,
  "version": "0.1.0",
  "description": "A free, local-first PDF annotation, fill, sign, and page-management editor.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SyedAkramaIrshad/leafpdf.git"
  },
  "homepage": "https://github.com/SyedAkramaIrshad/leafpdf#readme",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:large": "${PYTHON:-python3} scripts/create-large-fixture.py 78 && playwright test large-file",
    "verify:self-test": "${PYTHON:-python3} scripts/test_verify_export.py"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "pako": "^3.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
